# Agent server (apps/agent). Copy to a local .env; never commit real values.
AGENT_PORT=8787
AGENT_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-chars
# Optional local persistence (podman compose); without these, memory store is used.
DATABASE_URL=
REDIS_URL=
# Inngest dev server (optional). INNGEST_SIGNING_KEY enables /api/inngest.
INNGEST_DEV=
INNGEST_SIGNING_KEY=
# Loopback-only dev switch: any caller can impersonate any user when set.
TRUST_USER_HEADER=

# LLM routes (apps/agent + agent-core). Never hard-code model IDs.
LLM_BASE_URL=http://localhost:4000/v1
# Optional gateway bearer; no default (local Switchyard needs none).
LLM_API_KEY=
ROUTE_FAST=
ROUTE_DEEP=
ROUTE_RESEARCH=
ROUTE_ROUTER=
LLM_PROVIDER=mock

# Typed router (Phase 1). off = pre-router dispatch unchanged; shadow = log and
# compare both decisions while dispatching the pre-router route; live = dispatch proposed.
ROUTER_MODE=off
# Required when ROUTER_MODE is shadow or live. No default: fail closed.
JEV_API_KEY=
# Base URL and model alias for TypeSafe Jev's POST /v1/systemone choice API.
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Top-two probability gap below which the structured LLM router takes over.
ROUTER_MARGIN_THRESHOLD=0.15
# Hard budget in ms for Jev + fallback together. A stuck third party can never
# delay a chat turn beyond this; the deterministic baseline is used instead.
ROUTER_TIMEOUT_MS=1500
# PRIVACY: in shadow mode a fraction of turns is sent to api.typesafe.ai as
# routing input. Default 10%. Set 0 to send nothing; 1 to sample every turn.
ROUTER_SHADOW_SAMPLE=0.1
# Redact emails, URLs and long digit runs before they leave the process.
# Set to 0 only for local mock-only debugging.
ROUTER_REDACT=1

# /metrics is open on loopback. For any other AGENT_HOST, set a >=16-char
# token and scrape with `x-metrics-token: <token>`. No default.
METRICS_TOKEN=

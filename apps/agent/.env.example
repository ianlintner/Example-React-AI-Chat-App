# Agent server (apps/agent). Copy to a local .env; never commit real values.
AGENT_PORT=8787
AGENT_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-chars
# Optional local persistence (podman compose); without these, memory store is used.
DATABASE_URL=
REDIS_URL=
# Inngest dev server (optional). INNGEST_SIGNING_KEY enables /api/inngest.
INNGEST_DEV=
INNGEST_SIGNING_KEY=
# Loopback-only dev switch: any caller can impersonate any user when set.
TRUST_USER_HEADER=

# LLM routes (apps/agent + agent-core). Never hard-code model IDs.
LLM_BASE_URL=http://localhost:4000/v1
# Optional gateway bearer; no default (local Switchyard needs none).
LLM_API_KEY=
ROUTE_FAST=
ROUTE_DEEP=
ROUTE_RESEARCH=
ROUTE_ROUTER=
LLM_PROVIDER=mock

# Typed router (Phase 1). off = deterministic baseline only; shadow = log and
# compare both decisions without changing dispatch; live = dispatch proposed.
ROUTER_MODE=off
# Required when ROUTER_MODE is shadow or live. No default: fail closed.
JEV_API_KEY=
# Base URL and model alias for TypeSafe Jev's POST /v1/systemone choice API.
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Top-two probability gap below which the structured LLM router takes over.
ROUTER_MARGIN_THRESHOLD=0.15

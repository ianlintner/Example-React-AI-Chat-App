{
  "name": "agent-chat-app",
  "version": "1.0.0",
  "description": "Local-only agentic chat showcase: Hono agent + TanStack web + <agent-chat> embed.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:services && concurrently -k -n agent,web -c yellow,cyan \"npm run -w apps/agent dev\" \"npm run -w apps/web dev\"",
    "dev:services": "docker compose -f compose.dev.yml up -d --wait",
    "dev:services:down": "docker compose -f compose.dev.yml down",
    "dev:embed": "npm run -w apps/embed dev",
    "lint": "npm run format:check && npm run check:loc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:loc": "node scripts/check-loc.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "eval": "tsx scripts/eval.mjs",
    "eval:live": "EVAL_MODE=live tsx scripts/eval.mjs",
    "build": "npm run -w apps/web build && npm run -w apps/embed build",
    "e2e": "npm run build && playwright test && playwright test -c playwright.embed.config.ts",
    "e2e:embed": "playwright test -c playwright.embed.config.ts",
    "check:size:embed": "npm run -w apps/embed check:size",
    "storybook": "npm run -w apps/web storybook",
    "docs:lint": "prettier --check README.md ARCHITECTURE.md PLAN.md docs/**/*.md"
  },
  "keywords": [
    "ai",
    "agent",
    "chat",
    "typescript",
    "local-development"
  ],
  "author": "Ian Lintner",
  "license": "MIT",
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "prettier": "~3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "@babel/core": "^7.29.6",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": {
      ".": "^5.0.12",
      "minimatch@1": "^1.1.21",
      "minimatch@2": "^2.0.2",
      "minimatch@3": "^3.1.21"
    },
    "browserslist": "^4.29.6",
    "compression": "^1.8.2",
    "glob": "^14.0.2",
    "image-size": "^2.1.0",
    "js-yaml": "^4.3.2",
    "linkify-it": {
      "min": "^5.0.2"
    },
    "markdown-it": "14.3.3",
    "minimatch": {
      ".": "^11.0.1",
      "glob@7": "^3.1.4"
    },
    "nanoid": "^3.3.20",
    "node-forge": "^1.4.3",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.23",
    "shell-quote": "^1.9.0",
    "socket.io-parser": "^4.2.7",
    "source-map-js": "^1.2.2",
    "tar": "^7.5.21",
    "undici": "^6.29.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  }
}
